# notebooks 전용 환경변수 (이 파일을 .env 로 복사해서 값 채우기)
# 실제 값은 절대 커밋하지 않습니다. .gitignore 가 .env 를 제외합니다.
# 지금은 ai_safety_eval.ipynb 가 읽습니다. 같은 이름의 셸 환경변수가 있으면 그쪽이 이깁니다.

# --- OpenRouter --------------------------------------------------------------
# 평가 대상과 판정 모델을 같은 키로 부릅니다. serving/.env 의 OPENROUTER_API_KEY 와 같은 키를 써도 됩니다.
OPENROUTER_API_KEY=

# 평가 대상: 서빙의 추천 이유 모델. serving 의 REASON_MODEL 과 같게 둡니다. 비우면 코드 기본값입니다.
REASON_MODEL=google/gemini-3.5-flash-lite
# 판정 모델(deepeval 채점). 자기 답을 후하게 채점하지 않게 평가 대상과 다른 계열로 둡니다.
JUDGE_MODEL=openai/gpt-4.1-mini

# --- 재료 사전 (선택) --------------------------------------------------------
# 채우면 서빙처럼 ingredient 표 전체를 "지어낸 재료" 검사 사전으로 읽습니다(SELECT 만 합니다).
# 비우면 노트북에 내장한 흔한 재료 100여 종을 씁니다. 공용 dev 브랜치 pooler 주소면 됩니다.
DATABASE_URL=

# --- 실행 범위 ---------------------------------------------------------------
# 0 이면 시험 호출 1건만 합니다. 결과를 확인한 뒤 1 로 바꿔 전체를 돌립니다.
# 전체: 평가 대상 71회(할루시네이션 15, Injection 12종 x 3회, 편향 10쌍), 판정 모델 약 150~200회.
NB_RUN_FULL=0
