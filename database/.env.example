# database 전용 환경변수 (이 파일을 .env 로 복사해서 값 채우기)
# 실제 값은 절대 커밋하지 않습니다. .gitignore 가 .env 를 제외합니다.

# --- Neon PostgreSQL ---------------------------------------------------------
# Neon 콘솔 > Connection Details 에서 복사한 뒤 드라이버만 postgresql+asyncpg 로 바꿉니다.
# 브랜치별로 값이 다르므로 각자 본인 Neon 브랜치 URL 을 넣습니다.
#
# DATABASE_URL       : pooler 엔드포인트 (호스트에 -pooler 포함). 조회용 기본 연결.
# DATABASE_URL_DIRECT: direct 엔드포인트 (-pooler 없음). COPY 벌크 적재, alembic 용.
DATABASE_URL=
DATABASE_URL_DIRECT=

# Neon 브랜치 이름 (로그/리포트 식별용, 접속에는 쓰이지 않음)
NEON_BRANCH=
