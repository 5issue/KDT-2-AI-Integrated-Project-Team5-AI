# recsys_sql 전용 환경변수 (이 파일을 .env 로 복사해서 값 채우기)

# --- Neon PostgreSQL ---------------------------------------------------------
# 추천 SQL 검증은 본인 Neon 브랜치에서 수행합니다.
# 메인 브랜치를 그대로 쓰지 마세요. 테스트가 롤백되더라도 시퀀스/통계는 남습니다.
#
# Neon 콘솔 > Branches > Create branch 로 main 에서 브랜치를 딴 뒤
# 그 브랜치의 Connection Details 를 아래에 넣습니다. 드라이버만 postgresql+asyncpg 로 바꿉니다.
DATABASE_URL=
DATABASE_URL_DIRECT=

# 본인 Neon 브랜치 이름. 리포트에 찍혀서 어느 브랜치에 붙었는지 헷갈리지 않게 해줍니다.
NEON_BRANCH=

# --- 검증 옵션 ---------------------------------------------------------------
# 각자 SQL 을 두는 폴더 이름(github id). queries/<QUERY_OWNER>/ 를 기본 대상으로 봅니다.
# 비워두면 queries/ 아래 전부를 대상으로 합니다.
QUERY_OWNER=

# 쿼리 하나가 이 시간을 넘기면 실패 처리합니다(초). 느린 추천 쿼리를 조기에 잡기 위한 값입니다.
QUERY_TIMEOUT_SECONDS=10

# EXPLAIN 검증에서 금지할 노드. 큰 테이블 풀스캔이 끼면 실패시킵니다.
FORBID_SEQ_SCAN_ON=product,recipe,recipe_ingredient
