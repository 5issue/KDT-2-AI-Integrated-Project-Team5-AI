# data_pipeline 전용 환경변수 (이 파일을 .env 로 복사해서 값 채우기)
# 실제 값은 절대 커밋하지 않습니다. .gitignore 가 .env 를 제외합니다.

# --- Neon PostgreSQL ---------------------------------------------------------
# Neon 콘솔 > Connection Details 에서 복사한 뒤 드라이버만 postgresql+asyncpg 로 바꿉니다.
# 브랜치별로 값이 다르므로 각자 본인 Neon 브랜치 URL 을 넣습니다.
#
# DATABASE_URL       : pooler 엔드포인트 (호스트에 -pooler 포함). 앱/실험용 기본 연결.
# DATABASE_URL_DIRECT: direct 엔드포인트 (-pooler 없음). alembic 마이그레이션, COPY 벌크 적재용.
#
# 예) postgresql+asyncpg://<user>:<password>@ep-xxx-pooler.<region>.aws.neon.tech/<db>
DATABASE_URL=
DATABASE_URL_DIRECT=

# Neon 브랜치 이름 (로그/리포트 식별용, 접속에는 쓰이지 않음)
NEON_BRANCH=

# --- OpenAI ------------------------------------------------------------------
OPENAI_API_KEY=
# Batch API 파싱에 쓸 모델
OPENAI_BATCH_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# product/recipe/ingredient.embedding 컬럼이 VECTOR(1536) 이므로 기본 1536
EMBEDDING_DIM=1536
# Batch API 완료 기한 (현재 API 가 허용하는 값은 24h 뿐)
BATCH_COMPLETION_WINDOW=24h

# recipe.source_type 에 넣을 값입니다.
# 실제 스키마의 레시피 자연키가 (source_type, source_recipe_id) 조합이라,
# 출처가 여러 개면 여기를 바꿔가며 적재하면 서로 덮어쓰지 않습니다.
RECIPE_SOURCE_TYPE=LLM_PARSE

# --- 파이프라인 동작 ----------------------------------------------------------
# 한 배치 파일에 담을 최대 요청 수 (OpenAI 제한: 파일당 50,000줄 / 200MB)
BATCH_MAX_REQUESTS=40000
# COPY 로 staging 에 밀어넣을 때의 청크 크기
COPY_CHUNK_SIZE=5000
# true 면 실제 API 호출/DB 쓰기 없이 파일 생성까지만 수행
DRY_RUN=false
