# serving 전용 환경변수 (이 파일을 .env 로 복사해서 값 채우기)

# --- Neon PostgreSQL ---------------------------------------------------------
# 서빙은 pooler 엔드포인트(호스트에 -pooler 포함)를 씁니다.
# Neon 은 커넥션 수 제한이 빡빡해서 서버리스/멀티 워커 환경에서는 pooler 가 사실상 필수입니다.
DATABASE_URL=
NEON_BRANCH=

# --- 커넥션 풀 ---------------------------------------------------------------
# 워커 프로세스 하나당 크기입니다. uvicorn --workers 4 면 실제 커넥션은 4배가 됩니다.
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
# 풀에서 커넥션을 못 받으면 이 시간 뒤 포기합니다(초).
DB_POOL_TIMEOUT=10
# 쿼리 하나의 상한(초). 느린 쿼리가 워커를 붙잡지 않게 합니다.
DB_COMMAND_TIMEOUT=5

# --- 서버 -------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
# 쉼표로 구분한 허용 오리진. 비워두면 CORS 미들웨어를 켜지 않습니다.
CORS_ALLOW_ORIGINS=
# local | dev | prod. local 이 아니면 /docs 를 닫습니다.
ENVIRONMENT=local

# --- 종료 유예 ---------------------------------------------------------------
# SIGTERM 후 ALB 타깃 제외가 전파될 때까지 기다리는 시간(초). 502 방지.
# EKS 배포는 5 권장, 로컬/테스트는 0.
SHUTDOWN_DELAY_SECONDS=5

# --- Rate limit --------------------------------------------------------------
# /api/v1 분당 요청 한도. 0 이면 비활성. 추천 경로는 비용이 커서 별도(더 낮은) 한도.
# RECO 한도를 0 으로 두면 추천 경로도 기본 한도를 따릅니다 (완전 면제 아님).
# 프로세스별 카운터라 uvicorn --workers N 이면 실효 한도는 N 배가 됩니다.
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_RECO_PER_MINUTE=10

# --- 추천 이유 LLM 생성 -------------------------------------------------------
# rag_lab.reason_service 가 OpenRouter 를 부릅니다. 키가 비어 있으면 LLM 을 부르지 않고
# 규칙 기반 문구만 나갑니다 (문구 품질 실험 전까지 권장 상태). 모델을 비우면 코드 기본값.
# 카드별 제한 시간(2초)과 LLM 카드 수(3장)는 코드 상수입니다.
OPENROUTER_API_KEY=
REASON_MODEL=google/gemini-3.5-flash-lite
