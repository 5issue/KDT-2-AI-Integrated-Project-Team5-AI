# rag_lab 전용 환경변수 (이 파일을 .env 로 복사해서 값 채우기)

# --- Neon PostgreSQL ---------------------------------------------------------
# RAG 실험도 본인 Neon 브랜치에서 합니다. 인덱스를 새로 만들거나 지우는 실험이 잦아서
# main 브랜치에 직접 붙으면 다른 사람 실험이 같이 흔들립니다.
DATABASE_URL=
DATABASE_URL_DIRECT=
NEON_BRANCH=

# --- LLM ---------------------------------------------------------------------
# 공급자를 이 파일 한 줄로 바꿉니다. OpenAI / OpenRouter / Together / vLLM 은 전부
# OpenAI 호환 API 라 base_url 만 다릅니다. 목록은 rag_lab/src/rag_lab/providers.py 참고.
#
# openai     | 모델명에 접두사 없음.      gpt-4.1-mini
# openrouter | 모델명에 접두사 필요.      openai/gpt-4.1-mini, anthropic/claude-sonnet-4
# anthropic  | OpenAI SDK 호환 계층.
# custom     | self-hosted. LLM_BASE_URL 을 함께 채워야 합니다.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
# LLM_PROVIDER=custom 일 때만 씁니다. (예: http://localhost:8000/v1)
LLM_BASE_URL=

# 임베딩 모델. 채팅과 같은 곳에서 받으면 아래 세 줄은 비워 두세요.
LLM_EMBEDDING_MODEL=text-embedding-3-small

# **OpenRouter 와 Anthropic 은 임베딩 엔드포인트가 없습니다.**
# 채팅을 그쪽으로 보내면 임베딩은 여기서 따로 지정해야 합니다.
#   LLM_PROVIDER=openrouter / LLM_EMBEDDING_PROVIDER=openai  같은 조합
# self-hosted TEI 로 BAAI/bge-m3 를 쓰려면 custom + BASE_URL 조합입니다.
#
# **공급자나 주소를 따로 지정하면 LLM_EMBEDDING_API_KEY 도 채워야 합니다.**
# 채팅 키를 물려주면 그 키가 다른 회사 엔드포인트로 그대로 나갑니다.
# 아무것도 지정하지 않았을 때만 채팅 설정을 물려받습니다.
#
# BASE_URL 은 공인 호스트면 https 만 받습니다. 평문 http 는 루프백·사설망·
# 단일 이름(도커/쿠버네티스 서비스명)에서만 허용합니다. 키가 평문으로 나가지 않게.
LLM_EMBEDDING_PROVIDER=
LLM_EMBEDDING_API_KEY=
LLM_EMBEDDING_BASE_URL=

# recipe/product/ingredient.embedding 컬럼이 VECTOR(1536) 이라 기본 1536 입니다.
# 차원이 다른 모델로 바꾸려면(BAAI/bge-m3 는 1024) 컬럼 마이그레이션이 함께 필요합니다.
# 클라이언트가 응답 차원을 확인해서 다르면 바로 실패시킵니다.
EMBEDDING_DIM=1536

# --- 검색 파라미터 (실험에서 바꿔가며 비교하는 값들) ---------------------------
# 벡터 검색으로 가져올 후보 수
TOP_K=5
# 이 점수 아래는 근거로 쓰지 않습니다 (코사인 유사도, 0~1)
SCORE_THRESHOLD=0.25
# 벡터 거리 연산자: cosine | l2 | inner_product
DISTANCE_METRIC=cosine

# --- 실험 기록 ---------------------------------------------------------------
# 각자 실험 폴더 이름(github id). experiments/<EXPERIMENT_OWNER>/ 아래에 결과가 쌓입니다.
EXPERIMENT_OWNER=
